<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd agent that runs whisper-watchdog.sh every 3 minutes. launchd never starts a run while the previous one is
  still going, so a probe waiting behind a long chunk can't overlap the next.
  setup.sh fills in the __PLACEHOLDERS__ and installs it to ~/Library/LaunchAgents.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.earmarked.whisper-watchdog</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__DATA_DIR__/whisper-watchdog.sh</string>
        <string>http://__HOST__:__PORT__</string>
        <string>com.earmarked.whisper-server</string>
        <string>__DATA_DIR__/watchdog-clip.wav</string>
        <string>__DATA_DIR__/watchdog-failures</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>StartInterval</key>
    <integer>180</integer>
    <key>ProcessType</key>
    <string>Background</string>
    <key>StandardOutPath</key>
    <string>__WATCHDOG_LOG_PATH__</string>
    <key>StandardErrorPath</key>
    <string>__WATCHDOG_LOG_PATH__</string>
</dict>
</plist>
