<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd agent that keeps whisper.cpp's server running for PodcastBookRecs.
  setup.sh fills in the __PLACEHOLDERS__ and installs it to ~/Library/LaunchAgents.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.podcastbookrecs.whisper-server</string>
    <key>ProgramArguments</key>
    <array>
        <string>__BREW_PREFIX__/bin/whisper-server</string>
        <string>-m</string>
        <string>__MODEL_PATH__</string>
        <!-- Listen on the Mac's LAN address only, not on every interface. -->
        <string>--host</string>
        <string>__HOST__</string>
        <string>--port</string>
        <string>__PORT__</string>
        <!-- Serve the OpenAI-compatible path instead of whisper.cpp's default /inference. -->
        <string>--inference-path</string>
        <string>/v1/audio/transcriptions</string>
        <!-- Accept MP3 and other formats by converting with ffmpeg. -->
        <string>--convert</string>
        <string>-fa</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <!-- launchd's default PATH lacks Homebrew, and --convert runs ffmpeg by name. -->
        <key>PATH</key>
        <string>__BREW_PREFIX__/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>WorkingDirectory</key>
    <string>__DATA_DIR__</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>StandardOutPath</key>
    <string>__LOG_PATH__</string>
    <key>StandardErrorPath</key>
    <string>__LOG_PATH__</string>
</dict>
</plist>
