@page "/books"
@using PodcastBookRecs.Core.Backends
@using PodcastBookRecs.Core.Books
@inject IDbContextFactory<AppDbContext> DbFactory

<PageTitle>Books</PageTitle>

@* Books that mentions were matched to in the catalogue, most widely discussed first (BookRanking). *@
<PageHeader Eyebrow="Library" Title="Books" Subtitle="Every book the podcasts mentioned, ranked by how many podcasts and episodes brought it up.">
    <Actions>
        <MudTooltip Text="Refresh">
            <MudIconButton Icon="@Icons.Material.Rounded.Refresh" OnClick="LoadAsync" aria-label="Refresh" />
        </MudTooltip>
    </Actions>
</PageHeader>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">Couldn't load books: @_error</MudAlert>
}
else if (_rows is null)
{
    <LoadingState Layout="LoadingState.LoadingLayout.Cards" Count="9" />
}
else
{
    @if (_pending > 0 || _unmatched > 0)
    {
        <div class="notice">
            <MudIcon Icon="@Icons.Material.Outlined.Info" Size="Size.Small" />
            <MudText Typo="Typo.body2">
                @if (_pending > 0 && _lookupOn)
                {
                    <text>@_pending mention(s) still being checked against the catalogue. </text>
                }
                else if (_pending > 0)
                {
                    <text>Book lookup is off (<code>BookLookup:Provider</code> is empty), so @_pending mention(s) haven't been checked against a catalogue. </text>
                }
                @if (_unmatched > 0)
                {
                    <text>@_unmatched mention(s) weren't found in the catalogue and aren't listed. <a href="review" class="card-title-link">Review them</a> to rule them out or pick the right book.</text>
                }
            </MudText>
        </div>
    }

    @if (_rows.Count == 0)
    {
        <EmptyState Title="No books yet" Icon="@Icons.Material.Rounded.MenuBook">
            Books appear here once episodes have been searched for books and the titles found in the catalogue.
        </EmptyState>
    }
    else
    {
        <MudGrid Spacing="3" Class="stagger">
            @foreach (var row in _rows)
            {
                <MudItem xs="12" sm="6" lg="4" @key="row.Book.Id">
                    <a href="@($"books/{row.Book.Id}")" class="card-link surface-card hover-lift book-card">
                        <span class="rank @(row.Rank <= 3 ? "rank-top" : "")">@row.Rank</span>
                        @if (Display.HttpsOrNull(row.Book.CoverUrl) is { } cover)
                        {
                            <img src="@cover" alt="" loading="lazy" referrerpolicy="no-referrer" class="book-cover" />
                        }
                        else
                        {
                            <span class="book-cover book-cover-blank"><MudIcon Icon="@Icons.Material.Rounded.AutoStories" /></span>
                        }
                        <span class="book-card-body">
                            <MudText Typo="Typo.subtitle1" Class="clamp-2" Style="font-weight: 650; line-height: 1.3;">@row.Book.Title</MudText>
                            <MudText Typo="Typo.body2" Class="muted clamp-2">
                                @row.Book.Authors@(row.Book.FirstPublishYear is { } year ? $" · {year}" : "")
                            </MudText>
                            <span class="stat-row mt-2">
                                <span class="stat"><strong>@row.Ranking.Podcasts</strong> podcast(s)</span>
                                <span class="stat"><strong>@row.Ranking.Episodes</strong> episode(s)</span>
                                @if (row.Ranking.RecommendedIn > 0)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text" Icon="@Icons.Material.Rounded.ThumbUp" Class="state-chip ma-0">
                                        Recommended in @row.Ranking.RecommendedIn
                                    </MudChip>
                                }
                            </span>
                            <MudText Typo="Typo.caption" Class="muted mt-auto">Last mentioned @Display.LocalDate(row.Ranking.LastMentioned)</MudText>
                        </span>
                    </a>
                </MudItem>
            }
        </MudGrid>
    }
}

@code {
    private List<Row>? _rows;
    private int _pending;
    private bool _lookupOn;
    private int _unmatched;
    private string? _error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var facts = await db.BookMentions.AsNoTracking()
                .Where(m => m.BookId != null)
                .Select(m => new MentionFact(m.BookId!.Value, m.EpisodeId, m.Episode.PodcastFeedId, m.Episode.PublishedAt, m.Kind))
                .ToListAsync();
            var books = await db.Books.AsNoTracking().ToDictionaryAsync(b => b.Id);
            _pending = await db.BookMentions.CountAsync(m => m.MatchState == MatchState.Pending);
            _lookupOn = await db.WorkerStatuses.AnyAsync(s => s.Name == BackendHealth.BookLookup);
            _unmatched = await db.BookMentions.CountAsync(m => m.MatchState == MatchState.NoMatch || m.MatchState == MatchState.LookupFailed);
            _rows = BookRanking.Rank(facts)
                .Where(r => books.ContainsKey(r.BookId))
                .Select((r, i) => new Row(i + 1, books[r.BookId], r))
                .ToList();
            _error = null;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private sealed record Row(int Rank, Book Book, RankedBook Ranking);
}
