@page "/episodes/{Id:guid}"
@using PodcastBookRecs.Core.Backends
@using PodcastBookRecs.Core.Pipeline
@using PodcastBookRecs.Core.Transcripts
@inject IDbContextFactory<AppDbContext> DbFactory
@inject TimeProvider Time
@inject ISnackbar Snackbar

<PageTitle>@(_episode?.Title ?? "Episode")</PageTitle>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error">Couldn't load this episode: @_error</MudAlert>
}
else if (_loading)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
}
else if (_episode is null)
{
    <MudAlert Severity="Severity.Warning">Episode @Id doesn't exist.</MudAlert>
}
else
{
    <MudBreadcrumbs Items="_breadcrumbs" Class="px-0" />
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
        <MudText Typo="Typo.h4">@_episode.Title</MudText>
        <MudSpacer />
        @if (_episode.State is EpisodeState.Skipped)
        {
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.AddCircleOutline"
                       OnClick="@(() => QueueAsync(WorkerCommandType.IncludeEpisode, "Episode included. It joins the queue in its normal place."))">Include</MudButton>
        }
        @if (_episode.PrioritisedAt is null && (_episode.State is EpisodeState.Skipped || CommandProcessor.QueuedStates.Contains(_episode.State)))
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.KeyboardDoubleArrowUp"
                       OnClick="@(() => QueueAsync(WorkerCommandType.PrioritiseEpisode, "Moved to the front of the queue. Anything already running finishes first."))">Do this next</MudButton>
        }
        @if (_episode.State is EpisodeState.Extracted or EpisodeState.ExtractionFailed)
        {
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.MenuBook" OnClick="ReextractAsync">Re-run book extraction</MudButton>
        }
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Replay" OnClick="RetryAsync">Reset and retry</MudButton>
    </MudStack>

    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-4">
        <EpisodeStateChip State="_episode.State" />
        @if (_episode.PrioritisedAt is not null)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.KeyboardDoubleArrowUp">Prioritised</MudChip>
        }
        <MudText Typo="Typo.body2">Published @Display.LocalTime(_episode.PublishedAt)</MudText>
        @if (_episode.Duration is not null)
        {
            <MudText Typo="Typo.body2">· @Display.Timestamp(_episode.Duration)</MudText>
        }
        <MudText Typo="Typo.body2">· @_episode.TranscriptLinks.Count published transcript link(s)</MudText>
    </MudStack>

    @if (_episode.LastError is not null)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4">@_episode.LastError</MudAlert>
    }

    @if (_episode.Transcript is null)
    {
        <MudAlert Severity="Severity.Info">
            @(_episode.State switch
            {
                EpisodeState.AwaitingTranscription => "No published transcript. It's queued for transcription.",
                EpisodeState.Transcribing => "Transcribing now. Finished parts are kept, so it resumes after a restart.",
                EpisodeState.Failed => "Transcription gave up. Use Reset and retry to start again.",
                EpisodeState.Skipped => "Skipped: it was older than the backfill window when the podcast was added. Include it to process it.",
                _ => "No transcript yet.",
            })
        </MudAlert>
    }
    else
    {
        <MudText Typo="Typo.h6" Class="mb-2">Books mentioned</MudText>
        @if (_episode.State is EpisodeState.Extracted)
        {
            @if (_episode.Mentions.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="mb-4">No books found in this episode.</MudText>
            }
            else
            {
                <MudSimpleTable Dense="true" Hover="true" Elevation="1" Class="mb-6">
                    <tbody>
                        @foreach (var mention in _episode.Mentions.OrderBy(m => m.StartTime))
                        {
                            <tr>
                                <td style="white-space: nowrap; width: 1%;"><MudText Typo="Typo.caption">@Display.Timestamp(mention.StartTime)</MudText></td>
                                <td>
                                    @if (mention.Book is not null)
                                    {
                                        <MudLink Href="@($"books/{mention.Book.Id}")" Typo="Typo.subtitle2">@mention.Book.Title</MudLink>
                                        <MudText Typo="Typo.caption" Class="d-block">@mention.Book.Authors</MudText>
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.subtitle2">@mention.Title</MudText>
                                        @if (mention.Author is not null)
                                        {
                                            <MudText Typo="Typo.caption" Class="d-block">@mention.Author</MudText>
                                        }
                                        <MudText Typo="Typo.caption" Class="d-block mud-text-secondary">@Display.MatchNote(mention.MatchState, _lookupOn)</MudText>
                                    }
                                </td>
                                <td style="white-space: nowrap; width: 1%;"><MudChip T="string" Size="Size.Small" Color="Display.KindColor(mention.Kind)">@Display.KindLabel(mention.Kind)</MudChip></td>
                                <td><MudText Typo="Typo.body2">"@mention.Quote"</MudText></td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
                <MudText Typo="Typo.caption" Class="d-block mb-6">
                    Found by @_episode.Mentions[0].Provider · @_episode.Mentions[0].Model, prompt @_episode.Mentions[0].PromptVersion
                </MudText>
            }
        }
        else
        {
            <MudText Typo="Typo.body2" Class="mb-4">
                @(_episode.State switch
                {
                    EpisodeState.Extracting => "Searching the transcript for books now.",
                    EpisodeState.ExtractionFailed => "Book extraction gave up. Use Re-run book extraction to try again.",
                    _ => "Queued for book extraction.",
                })
            </MudText>
        }

        <MudText Typo="Typo.h6" Class="mb-2">
            Transcript · @Display.TranscriptOrigin(_episode.Transcript), @_episode.Transcript.Segments.Count segments
        </MudText>
        <MudSimpleTable Dense="true" Hover="true" Elevation="1">
            <tbody>
                @foreach (var segment in _episode.Transcript.Segments)
                {
                    <tr>
                        <td style="white-space: nowrap; width: 1%;"><MudText Typo="Typo.caption">@Display.Timestamp(segment.Start)</MudText></td>
                        <td style="white-space: nowrap; width: 1%;"><MudText Typo="Typo.caption">@segment.Speaker</MudText></td>
                        <td><MudText Typo="Typo.body2">@segment.Text</MudText></td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    }
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private Episode? _episode;
    private bool _lookupOn;
    private List<BreadcrumbItem> _breadcrumbs = [];
    private bool _loading = true;
    private string? _error;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            _episode = await db.Episodes.AsNoTracking()
                .Include(e => e.PodcastFeed)
                .Include(e => e.Transcript)
                .Include(e => e.Mentions).ThenInclude(m => m.Book)
                .SingleOrDefaultAsync(e => e.Id == Id);
            _lookupOn = await db.WorkerStatuses.AnyAsync(s => s.Name == BackendHealth.BookLookup);
            if (_episode is not null)
            {
                _breadcrumbs =
                [
                    new("Podcasts", ""),
                    new(_episode.PodcastFeed.Title ?? "Podcast", $"podcasts/{_episode.PodcastFeedId}"),
                    new("Episode", null, disabled: true),
                ];
            }

            _error = null;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private Task ReextractAsync() => QueueAsync(WorkerCommandType.ReextractEpisode, "Book extraction queued. The transcript is kept.");

    private Task RetryAsync() => QueueAsync(WorkerCommandType.RetryEpisode, "Retry queued. Any stored transcript will be fetched again.");

    /// <summary>Asks the Worker to act on this episode. The Worker picks the command up within about 5 seconds.</summary>
    private async Task QueueAsync(WorkerCommandType type, string done)
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            db.WorkerCommands.Add(new WorkerCommand { Type = type, EpisodeId = Id, CreatedAt = Time.GetUtcNow().UtcDateTime });
            await db.SaveChangesAsync();
            Snackbar.Add(done, Severity.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Couldn't send that to the Worker: {ex.Message}", Severity.Error);
        }
    }
}
