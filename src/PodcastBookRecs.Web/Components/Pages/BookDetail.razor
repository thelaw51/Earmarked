@page "/books/{Id:guid}"
@using PodcastBookRecs.Core.Configuration
@inject IDbContextFactory<AppDbContext> DbFactory
@inject ILogger<BookDetail> Logger

<PageTitle>@(_book?.Title ?? "Book")</PageTitle>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_error</MudAlert>
}
else if (_loading)
{
    <LoadingState Layout="LoadingState.LoadingLayout.Detail" Count="4" />
}
else if (_book is null)
{
    <EmptyState Title="Book not found" Icon="@Icons.Material.Rounded.SearchOff">Book @Id doesn't exist.</EmptyState>
}
else
{
    var cover = Display.HttpsOrNull(_book.CoverUrl);
    <div class="crumbs"><MudBreadcrumbs Items="_breadcrumbs" /></div>
    <section class="hero">
        @if (cover is not null)
        {
            <img src="@cover" alt="" class="hero-backdrop" referrerpolicy="no-referrer" />
        }
        <div class="hero-body">
            @if (cover is not null)
            {
                <img src="@cover" alt="" referrerpolicy="no-referrer" class="book-cover book-cover-lg" />
            }
            else
            {
                <span class="book-cover book-cover-lg book-cover-blank"><MudIcon Icon="@Icons.Material.Rounded.AutoStories" Size="Size.Large" /></span>
            }
            <div class="hero-text">
                <MudText Typo="Typo.overline" Color="Color.Primary">Book</MudText>
                <MudText Typo="Typo.h4">@_book.Title</MudText>
                @if (_book.Authors.Length > 0)
                {
                    <MudText Typo="Typo.subtitle1" Class="muted mt-1">@_book.Authors</MudText>
                }
                <div class="hero-meta">
                    @if (_book.FirstPublishYear is { } year)
                    {
                        <span><MudIcon Icon="@Icons.Material.Rounded.CalendarMonth" Size="Size.Small" /> First published @year</span>
                    }
                    <span><MudIcon Icon="@Icons.Material.Rounded.Podcasts" Size="Size.Small" /> @_mentions.Select(m => m.Episode.PodcastFeedId).Distinct().Count() podcast(s)</span>
                    @if (_book.Provider == BookLookupProviders.Manual)
                    {
                        <span><MudIcon Icon="@Icons.Material.Rounded.BookmarkAdded" Size="Size.Small" /> Not in any catalogue, kept as is in review</span>
                    }
                </div>
                @if (Display.HttpsOrNull(_book.InfoUrl) is { } info)
                {
                    <MudButton Href="@info" Target="_blank" rel="noopener noreferrer" Variant="Variant.Outlined" Color="Color.Primary"
                               EndIcon="@Icons.Material.Rounded.OpenInNew" Size="Size.Small" Class="mt-4">View on @_book.Provider</MudButton>
                }
            </div>
        </div>
    </section>

    <div class="section-title">
        <MudText Typo="Typo.h6">Mentioned in</MudText>
        <span class="count-badge">@_mentions.Select(m => m.EpisodeId).Distinct().Count() episode(s)</span>
    </div>
    <div class="surface-card stagger">
        @foreach (var mention in _mentions)
        {
            <div class="mention" @key="mention.Id">
                <MudChip T="string" Size="Size.Small" Color="Display.KindColor(mention.Kind)" Variant="Variant.Text" Class="state-chip ma-0">@Display.KindLabel(mention.Kind)</MudChip>
                <div style="min-width: 0;">
                    <a href="@($"episodes/{mention.EpisodeId}")" class="card-title-link"><MudText Typo="Typo.subtitle2">@mention.Episode.Title</MudText></a>
                    <MudText Typo="Typo.caption" Class="muted d-block">
                        @(mention.Episode.PodcastFeed.Title ?? "Podcast") · @Display.LocalDate(mention.Episode.PublishedAt)
                    </MudText>
                </div>
                @* Each moment links to its row in the episode's transcript; untimed transcripts link to the episode's books. *@
                <a href="@TranscriptLinks.Href(mention.EpisodeId, mention.StartTime)" class="timestamp timestamp-link"
                   title="Show this moment in the transcript">@(mention.StartTime is null ? "In episode" : Display.Timestamp(mention.StartTime))</a>
                <blockquote class="quote mention-quote"><MudText Typo="Typo.body2">"@mention.Quote"</MudText></blockquote>
            </div>
        }
    </div>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private Book? _book;
    private List<BookMention> _mentions = [];
    private List<BreadcrumbItem> _breadcrumbs = [];
    private bool _loading = true;
    private string? _error;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            _book = await db.Books.AsNoTracking().SingleOrDefaultAsync(b => b.Id == Id);
            _mentions = _book is null
                ? []
                : await db.BookMentions.AsNoTracking()
                    .Include(m => m.Episode).ThenInclude(e => e.PodcastFeed)
                    .Where(m => m.BookId == Id)
                    .OrderByDescending(m => m.Episode.PublishedAt)
                    .ToListAsync();
            _breadcrumbs = [new("Books", "books"), new(_book?.Title ?? "Book", null, disabled: true)];
            _error = null;
        }
        catch (Exception ex)
        {
            _error = Logger.LoadFailed(ex, "this book");
        }
        finally
        {
            _loading = false;
        }
    }
}
