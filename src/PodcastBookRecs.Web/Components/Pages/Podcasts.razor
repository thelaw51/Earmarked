@page "/"
@inject IDbContextFactory<AppDbContext> DbFactory
@inject TimeProvider Time
@inject ISnackbar Snackbar
@inject CommandFeedback Commands
@inject ILogger<Podcasts> Logger

<PageTitle>Podcasts</PageTitle>

<PageHeader Eyebrow="Library" Title="Podcasts" Subtitle="The feeds being watched for book mentions. New episodes are picked up on each poll.">
    <Actions>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Sync" OnClick="PollAllAsync">Poll all now</MudButton>
        <MudTooltip Text="Refresh">
            <MudIconButton Icon="@Icons.Material.Rounded.Refresh" OnClick="LoadAsync" aria-label="Refresh" />
        </MudTooltip>
    </Actions>
</PageHeader>

<div class="surface-card add-feed">
    <span class="add-feed-icon"><MudIcon Icon="@Icons.Material.Rounded.RssFeed" /></span>
    <MudTextField T="string" @bind-Value="_newFeedUrl" Label="Add a podcast by RSS feed URL" Variant="Variant.Outlined" Margin="Margin.Dense"
                  InputType="InputType.Url" Immediate="true" OnKeyDown="OnFeedKeyDown"
                  HelperText="Private feed URLs are stored as entered but only the host is ever shown." />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Add" OnClick="AddFeedAsync"
               Disabled="@(_adding || string.IsNullOrWhiteSpace(_newFeedUrl))" DropShadow="false">Add feed</MudButton>
</div>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_error</MudAlert>
}
else if (_rows is null)
{
    <LoadingState Layout="LoadingState.LoadingLayout.Cards" Count="6" />
}
else if (_rows.Count == 0)
{
    <EmptyState Title="No podcasts yet" Icon="@Icons.Material.Rounded.Podcasts">
        Paste a feed URL above, or list feeds under <code>Feeds</code> in config.json.
    </EmptyState>
}
else
{
    <MudGrid Spacing="3" Class="stagger">
        @foreach (var row in _rows)
        {
            <MudItem xs="12" sm="6" lg="4" @key="row.Id">
                <div class="surface-card hover-lift podcast-card">
                    <a href="@($"podcasts/{row.Id}")" class="card-link podcast-card-top">
                        <span class="artwork">
                            @if (Display.HttpOrHttpsOrNull(row.ImageUrl) is { } artwork)
                            {
                                <img src="@artwork" alt="" loading="lazy" referrerpolicy="no-referrer" />
                            }
                            else
                            {
                                <MudIcon Icon="@Icons.Material.Rounded.Podcasts" />
                            }
                        </span>
                        <span class="d-flex flex-column" style="min-width: 0;">
                            <MudText Typo="Typo.subtitle1" Class="clamp-2" Style="font-weight: 650; line-height: 1.3;">@(row.Title ?? FeedUrlRedactor.Redact(row.FeedUrl))</MudText>
                            @if (row.Author is not null)
                            {
                                <MudText Typo="Typo.body2" Class="muted clamp-2">@row.Author</MudText>
                            }
                        </span>
                    </a>
                    <div class="stat-row">
                        <span class="stat"><strong>@row.Active</strong> episodes</span>
                        <span class="stat"><strong>@row.Fetched</strong> with transcript</span>
                        @if (row.Awaiting > 0)
                        {
                            <span class="stat"><strong>@row.Awaiting</strong> awaiting</span>
                        }
                        @if (row.Skipped > 0)
                        {
                            <span class="stat"><strong>@row.Skipped</strong> skipped</span>
                        }
                    </div>
                    <div class="podcast-card-footer">
                        @if (row.LastPollError is not null)
                        {
                            <MudTooltip Text="@row.LastPollError">
                                <MudIcon Icon="@Icons.Material.Rounded.ErrorOutline" Color="Color.Error" Size="Size.Small" />
                            </MudTooltip>
                        }
                        <MudText Typo="Typo.caption" Class="muted">Polled @Display.LocalTime(row.LastPolledAt)</MudText>
                        <MudSpacer />
                        <MudTooltip Text="@(row.Enabled ? "Polling on" : "Polling off")">
                            <MudSwitch T="bool" Value="row.Enabled" ValueChanged="@(v => SetEnabledAsync(row, v))" Color="Color.Primary" Size="Size.Small" AriaLabel="Polling enabled" />
                        </MudTooltip>
                        <MudTooltip Text="Poll now">
                            <MudIconButton Icon="@Icons.Material.Rounded.Sync" Size="Size.Small" OnClick="@(() => PollAsync(row))" aria-label="Poll now" />
                        </MudTooltip>
                    </div>
                </div>
            </MudItem>
        }
    </MudGrid>
}

@code {
    private sealed record Row(Guid Id, string FeedUrl, string? Title, string? Author, string? ImageUrl, bool Enabled,
        DateTime? LastPolledAt, string? LastPollError, int Active, int Fetched, int Awaiting, int Skipped)
    {
        public bool Enabled { get; set; } = Enabled;
    }

    private List<Row>? _rows;
    private string? _error;
    private string? _newFeedUrl;
    private bool _adding;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            _rows = await db.PodcastFeeds
                .OrderBy(p => p.Title)
                .Select(p => new Row(p.Id, p.FeedUrl, p.Title, p.Author, p.ImageUrl, p.Enabled, p.LastPolledAt, p.LastPollError,
                    p.Episodes.Count(e => e.State != EpisodeState.Skipped),
                    p.Episodes.Count(e => e.Transcript != null),
                    p.Episodes.Count(e => e.State == EpisodeState.AwaitingTranscription),
                    p.Episodes.Count(e => e.State == EpisodeState.Skipped)))
                .ToListAsync();
            _error = null;
        }
        catch (Exception ex)
        {
            _error = Logger.LoadFailed(ex, "podcasts");
        }
    }

    private async Task OnFeedKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await AddFeedAsync();
        }
    }

    private async Task AddFeedAsync()
    {
        var url = _newFeedUrl?.Trim();
        if (!FeedUrl.IsValid(url))
        {
            Snackbar.Add("Enter a full http:// or https:// feed URL.", Severity.Warning);
            return;
        }

        _adding = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            if (await db.PodcastFeeds.AnyAsync(p => p.FeedUrl == url))
            {
                Snackbar.Add("That feed is already in the list.", Severity.Info);
                return;
            }

            var now = Time.GetUtcNow().UtcDateTime;
            var podcast = new PodcastFeed { FeedUrl = url!, AddedAt = now };
            db.PodcastFeeds.Add(podcast);
            var poll = new WorkerCommand { Type = WorkerCommandType.PollFeed, PodcastFeedId = podcast.Id, CreatedAt = now };
            db.WorkerCommands.Add(poll);
            await db.SaveChangesAsync();
            Commands.Watch(poll.Id);

            _newFeedUrl = null;
            Snackbar.Add("Feed added. The Worker will poll it within a few seconds.", Severity.Success);
            await LoadAsync();
        }
        // Someone else added the same feed between the check above and this save.
        catch (DbUpdateException ex) when (ex.InnerException is Microsoft.Data.Sqlite.SqliteException { SqliteErrorCode: 19 })
        {
            Snackbar.Add("That feed is already in the list.", Severity.Info);
        }
        catch (Exception ex)
        {
            Logger.ActionFailed(ex, "add feed");
            Snackbar.Add("Couldn't add the feed. The web app's log has the details.", Severity.Error);
        }
        finally
        {
            _adding = false;
        }
    }

    private Task PollAsync(Row row) => Commands.QueueAsync(new WorkerCommand { Type = WorkerCommandType.PollFeed, PodcastFeedId = row.Id }, "Poll queued.");

    private Task PollAllAsync() => Commands.QueueAsync(new WorkerCommand { Type = WorkerCommandType.PollAllFeeds }, "Poll of all feeds queued.");

    private async Task SetEnabledAsync(Row row, bool enabled)
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            await db.PodcastFeeds.Where(p => p.Id == row.Id).ExecuteUpdateAsync(s => s.SetProperty(p => p.Enabled, enabled));
            row.Enabled = enabled;
        }
        catch (Exception ex)
        {
            Logger.ActionFailed(ex, "enable or disable feed");
            Snackbar.Add("Couldn't update the feed. The web app's log has the details.", Severity.Error);
        }
    }
}
