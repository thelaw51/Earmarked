@* The title row every list page starts with: an eyebrow label, the title, an optional line under it, and actions on the right. *@
<header class="page-header">
    <div class="page-header-text">
        @if (Eyebrow is not null)
        {
            <MudText Typo="Typo.overline" Color="Color.Primary" Class="d-block">@Eyebrow</MudText>
        }
        <MudText Typo="Typo.h4" Class="page-title">@Title</MudText>
        @if (Subtitle is not null)
        {
            <MudText Typo="Typo.body1" Class="page-subtitle">@Subtitle</MudText>
        }
    </div>
    @if (Actions is not null)
    {
        <div class="page-header-actions">@Actions</div>
    }
</header>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = "";

    [Parameter]
    public string? Eyebrow { get; set; }

    [Parameter]
    public string? Subtitle { get; set; }

    [Parameter]
    public RenderFragment? Actions { get; set; }
}
