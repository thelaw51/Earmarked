@using PodcastBookRecs.Core.Pipeline

@* Where an episode is in the pipeline, as three steps: get a transcript, find books, done. With extraction off, an
   episode that stopped at its transcript shows "Find books" as off rather than done. *@
<ol class="pipeline-steps" aria-label="Pipeline progress">
    @for (var i = 0; i < Steps.Length; i++)
    {
        var (icon, label) = Steps[i];
        var status = i == BooksStep && _booksOff ? "off"
            : i < _completed ? "done" : i == _completed ? (_failed ? "failed" : State == EpisodeState.Skipped ? "todo" : "current") : "todo";
        <li class="pipeline-step pipeline-step-@status">
            <span class="pipeline-step-icon">
                <MudIcon Icon="@(status switch { "done" => Icons.Material.Rounded.Check, "failed" => Icons.Material.Rounded.PriorityHigh, "off" => Icons.Material.Rounded.Block, _ => icon })" Size="Size.Small" />
            </span>
            <MudText Typo="Typo.body2" Class="pipeline-step-label">@(status == "off" ? label + " (off)" : label)</MudText>
        </li>
    }
</ol>

@code {
    private static readonly (string Icon, string Label)[] Steps =
    [
        (Icons.Material.Rounded.GraphicEq, "Transcript"),
        (Icons.Material.Rounded.ManageSearch, "Find books"),
        (Icons.Material.Rounded.AutoStories, "Done"),
    ];

    private const int BooksStep = 1;

    private int _completed;
    private bool _failed;
    private bool _booksOff;

    [Parameter, EditorRequired]
    public EpisodeState State { get; set; }

    /// <summary>Whether the Worker has book extraction configured.</summary>
    [Parameter, EditorRequired]
    public bool ExtractionOn { get; set; }

    protected override void OnParametersSet()
    {
        (_completed, _failed) = Display.Progress(State, ExtractionOn);
        _booksOff = !ExtractionOn && PriorityRelease.FinishedWithoutExtraction.Contains(State);
    }
}
