@implements IDisposable
@inject SchemaStatus Schema
@inject ILogger<SchemaGate> Logger

@if (_ready)
{
    @ChildContent
}
else if (_error is not null)
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
else
{
    <MudAlert Severity="Severity.Info" Icon="@Icons.Material.Filled.HourglassTop">
        Waiting for the Worker to create or upgrade the database. This page will continue on its own.
    </MudAlert>
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mt-2" />
}

@code {
    /// <summary>Content shown once the database schema is current.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private readonly CancellationTokenSource _cts = new();
    private bool _ready;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(3));
            var logged = false;
            do
            {
                // A check can fail while the Worker is still creating the database, so keep trying and log only the first.
                try
                {
                    _ready = await Schema.IsReadyAsync(_cts.Token);
                    _error = null;
                }
                catch (Exception ex) when (ex is not OperationCanceledException)
                {
                    if (!logged)
                    {
                        Logger.ActionFailed(ex, "check database schema");
                        logged = true;
                    }

                    _error = "Can't read the database yet. This page keeps trying; the web app's log has the details.";
                }

                if (_ready)
                {
                    return;
                }

                StateHasChanged();
            }
            while (await timer.WaitForNextTickAsync(_cts.Token));
        }
        catch (OperationCanceledException)
        {
        }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
