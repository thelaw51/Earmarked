@inherits LayoutComponentBase

@* Used by pages rendered without a circuit (sign-in, sign-out, errors), so nothing here may need interactivity.
   Without a circuit the theme provider can't ask the browser for dark mode, so app.css follows prefers-color-scheme here. *@
<MudThemeProvider Theme="AppTheme.Theme" />

<div class="account-shell">
    <div class="account-glow" aria-hidden="true"></div>
    <div class="account-card">
        <div class="brand brand-large mb-6">
            <span class="brand-mark"><MudIcon Icon="@Icons.Material.Rounded.AutoStories" /></span>
            <span>
                <span class="brand-name d-block">Podcast Book Recs</span>
                <MudText Typo="Typo.caption" Class="account-tagline">Every book your podcasts talk about, in one place.</MudText>
            </span>
        </div>
        @Body
    </div>
</div>
