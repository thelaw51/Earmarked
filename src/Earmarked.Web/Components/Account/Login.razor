@page "/account/login"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@layout AccountLayout
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using Earmarked.Core.Accounts
@using Earmarked.Core.Configuration
@inject SignInManager<AppUser> SignInManager
@inject SchemaStatus Schema
@inject NavigationManager Navigation

@* Static SSR: signing in sets a cookie, which needs the HTTP response that an interactive circuit doesn't have.
   MudBlazor inputs need a circuit, so the fields are plain inputs styled in app.css. *@
<PageTitle>Sign in</PageTitle>

<MudText Typo="Typo.h5" Class="mb-1">Welcome back</MudText>
<MudText Typo="Typo.body2" Class="account-tagline mb-2">Sign in to see what your podcasts have been reading.</MudText>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="my-3">@_error</MudAlert>
}

<EditForm Model="Input" method="post" OnValidSubmit="SignInAsync" FormName="login" class="account-form">
    <DataAnnotationsValidator />
    <label for="email">Email</label>
    <InputText id="email" type="email" @bind-Value="Input.Email" autocomplete="username" autofocus />
    <ValidationMessage For="() => Input.Email" />

    <label for="password">Password</label>
    <InputText id="password" type="password" @bind-Value="Input.Password" autocomplete="current-password" />
    <ValidationMessage For="() => Input.Password" />

    <label class="account-check">
        <InputCheckbox @bind-Value="Input.RememberMe" /> Keep me signed in
    </label>

    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" DropShadow="false" Class="mt-5">Sign in</MudButton>
</EditForm>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = null!;

    [SupplyParameterFromForm]
    private LoginInput Input { get; set; } = null!;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private string? _error;

    protected override void OnInitialized() => Input ??= new();

    private async Task SignInAsync()
    {
        // Querying a missing database file would create it, and only the Worker may do that.
        if (!await Schema.IsReadyAsync(HttpContext.RequestAborted))
        {
            _error = "The Worker hasn't created the database yet. Try again in a minute.";
            return;
        }

        var result = await PasswordSignIn.SignInAsync(SignInManager, Input.Email, Input.Password, Input.RememberMe);
        if (result.Succeeded)
        {
            Navigation.NavigateTo(ReturnUrls.LocalOrHome(ReturnUrl));
            return;
        }

        // The password was right. Identity has set a short-lived cookie naming the user, which the next page reads.
        if (result.RequiresTwoFactor)
        {
            Navigation.NavigateTo(
                $"account/login-2fa?ReturnUrl={Uri.EscapeDataString(ReturnUrls.LocalOrHome(ReturnUrl))}&RememberMe={Input.RememberMe}");
            return;
        }

        // Otherwise the re-rendered form sends the password back to the browser in its value attribute.
        Input.Password = "";
        // One message for every failure. An email with no account never locks, so a separate lockout message would
        // tell anyone who tried five times whether the address has an account.
        _error = FailedMessage;
    }

    private static readonly string FailedMessage =
        $"Email or password is incorrect. After {IdentityExtensions.MaxFailedAccessAttempts} wrong attempts in a row, " +
        $"sign-in is blocked for {IdentityExtensions.LockoutDuration.TotalMinutes:0} minutes.";

    private sealed class LoginInput
    {
        [Required, EmailAddress]
        public string Email { get; set; } = "";

        [Required]
        public string Password { get; set; } = "";

        public bool RememberMe { get; set; }
    }
}
